PORT=3000
NODE_ENV=development

# Reverse proxy: number of hops in front of the app (e.g. 1 behind nginx).
# Leave unset for direct exposure. Setting this incorrectly allows IP spoofing.
# TRUST_PROXY=1

# CORS: comma-separated allowed origins, or "*" (opt-in).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rstudio_db
DB_USER=postgres
DB_PASSWORD=your_password

# Connection-pool tuning (optional)
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=5000

# bcrypt cost factor (10-12 typical; 12 recommended for production)
# BCRYPT_COST=12

# JWT
JWT_ACCESS_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# USD → INR conversion rate used when billing in INR via Razorpay (update periodically)
USD_TO_INR=90

# Twilio (SMS verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Brevo transactional email (OTP verification + VM resource alerts)
# Get your API key from Brevo -> Settings -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=noreply@rstudio.app
BREVO_FROM_NAME=Rach Dev LLP
# Public-facing frontend URL — used to build links in emails
APP_URL=https://rstudio.app

ANTHROPIC_API_KEY=
# Phone numbers
# A number typed without a country code is read as belonging to this country,
# so a bare "9876543210" becomes +91 9876543210. A fallback only: an explicit
# "+1 415 555 0100" is still parsed as US.
DEFAULT_PHONE_COUNTRY=IN

# SMS verification codes
# The name the code is attributed to. An unbranded code is indistinguishable
# from spam, and the recipient's safest move is to ignore it.
SMS_BRAND=Rstudio Studio
# Domain for the origin-bound autofill line (@domain #code). It must match the
# ORIGIN of the page waiting for the code or the browser will not offer it, so
# this is the Studio host rather than APP_URL — sign-up happens on Studio.
# Autofill is simply absent elsewhere, which is harmless.
SMS_OTP_DOMAIN=studio.rstudio.app

# Where the Studio app is served — used to build password-reset links for
# Studio users and by the OAuth redirect. Set this to the LOCAL url in a
# local .env, or reset emails you generate while developing will send you
# to production.
STUDIO_APP_URL=https://studio.rstudio.app

# Origin -> audience. Matched LITERALLY, so localhost and 127.0.0.1 are two
# entries. An unlisted origin falls back to 'platform', which means Studio
# endpoints answer 403 and sign-up silently skips workspace provisioning.
AUDIENCE_ORIGINS=https://studio.rstudio.app=studio,https://admin.rstudio.app=admin,http://localhost:3100=studio,http://127.0.0.1:3100=studio

# Invoicing — the seller's own details. NO DEFAULTS ON PURPOSE: an invoice with
# the wrong GSTIN cannot be claimed against and has to be cancelled and reissued.
# Leave GSTIN and STATE unset and invoices are issued as bills of supply with no
# tax, which is the correct document for a supplier who is not registered.
SELLER_LEGAL_NAME=Rstudio LLP
SELLER_GSTIN=
SELLER_STATE=
SELLER_ADDRESS=
# Prices are GST-EXCLUSIVE: this is added on top at checkout.
GST_RATE=18

# ── The admin SQL console ─────────────────────────────────────────────────────
# Its own database role, so the console can hold nothing but CONNECT and SELECT
# while the app keeps the privileges it needs to migrate and write.
#
# This is not belt-and-braces. A read-only transaction stops writes, but it does
# NOT stop `COPY ... TO PROGRAM`, which runs a shell command on the database
# server, nor pg_read_file(). Both need superuser or one of the pg_*_server_files
# roles — which a database user made with `createuser` very often has. The
# console refuses to run at all on such a connection.
#
#   CREATE ROLE studio_console LOGIN PASSWORD '...' NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   GRANT CONNECT ON DATABASE <db> TO studio_console;
#   GRANT USAGE ON SCHEMA public TO studio_console;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO studio_console;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO studio_console;
#
# Leave both unset if the app's own DB_USER is already not a superuser.
ADMIN_QUERY_DB_USER=
ADMIN_QUERY_DB_PASSWORD=
# Optional. Defaults: 5000ms, 500 rows.
ADMIN_QUERY_TIMEOUT_MS=
ADMIN_QUERY_MAX_ROWS=

# ── Culling ───────────────────────────────────────────────────────────────────
# Where persona working directories live — `<slug>/candidates` and `<slug>/seed`.
# Only the machine that generates candidates needs this; the API reads it to
# serve a candidate frame and to write the seed set on export, and reports
# `frames_present: false` when the directory is not there.
STUDIO_PERSONA_DIR=

# Candidate image URLs are signed, because an <img> tag carries no bearer token.
# Signed with STUDIO_STORAGE_SECRET (falling back to STUDIO_WORKER_TOKEN, then
# JWT_ACCESS_SECRET); with none of them set the console refuses to mint URLs
# rather than minting forgeable ones. Default TTL 10 minutes.
STUDIO_CANDIDATE_URL_TTL_MS=

# Base Flux, with no LoRA adapter — used only by the `seed_still` stage, which
# generates the candidate pool an avatar's LoRA is trained FROM. Every other
# still goes through FAL_STILL_MODEL and refuses without an adapter.
FAL_BASE_MODEL=

# Which stages this worker asks for. Defaults to `still,seed_still`; a worker
# left on `still` alone will never pick up candidate generation and the jobs
# sit queued looking like nobody started them.
WORKER_STAGES=

# ── Rendering ────────────────────────────────────────────────────────────────
# fal jobs are rendered by the API process itself. Nothing to start, and nothing
# to forget to start: a fal render is an HTTPS request and a wait, so a separate
# process for it only adds a way for the queue to sit still with no explanation.
#
# It claims nothing unless FAL_KEY is set, so a deployment without one behaves
# exactly as it did before — the jobs wait for a worker that has a key.
#
#   off   do not render in this process (for splitting web and render instances)
STUDIO_CLOUD_RUNNER=

# How many fal renders run at once. Waiting on fal is not work, so this is about
# how fast a batch lands rather than how much this machine can bear: 24 frames
# at 3 at a time is about five minutes, one at a time is about sixteen.
# Clamped to 1–12, default 3. A deliberate 0 becomes 1 rather than silently
# rendering nothing — to render nothing, set STUDIO_CLOUD_RUNNER=off above.
STUDIO_CLOUD_CONCURRENCY=

# Lease held per in-flight render, seconds. Renewed on a timer at a third of
# this, so two consecutive misses still leave room before the reaper requeues
# the job. 60–3600, default 300.
STUDIO_CLOUD_LEASE_SECONDS=

# How long to wait after finding the queue empty, milliseconds. Default 3000.
STUDIO_CLOUD_POLL_MS=

# worker/index.js is still how you run stages on hardware you own — a Mac with
# ComfyUI, or a rented GPU. It is no longer needed to use fal.

# The identity-preserving endpoint. A pool frame is generated FROM the face the
# customer chose rather than from the description again — text names a TYPE of
# person, so independent draws are different people who all match the words.
FAL_ANCHORED_MODEL=

# What that endpoint costs per megapixel, in cents. The default equals the plain
# still rate, which is a PLACEHOLDER: confirm the real rate on fal's pricing page
# and set it here. cost_cents exists so the self-hosting decision is a query
# rather than a guess, and a made-up rate poisons it in the direction nobody
# notices — undercharging.
FAL_PRICE_ANCHORED_MP_CENTS=

# Seed-set checks. The `embed` stage measures the faces in a culled set with
# insightface so training can refuse a set that is not confidently one person.
#
# The API runs these ITSELF when the machine it is on can — same question as
# FAL_KEY, different capability. It asks at boot by importing insightface in a
# subprocess; if that fails it claims nothing and the checks wait for a worker
# on a machine that can. So on a laptop running the whole Studio there is
# nothing to start.
#
#   off   do not check seed sets in the API process
STUDIO_EMBED_RUNNER=

# Which python. The probe and the embedder both use it.
FACE_EMBED_PYTHON=

# The render worker also claims checks, for the case where the API's machine
# cannot but another one can.
#
#   off   this worker's machine has no insightface; leave the checks for one
#         that does, rather than failing them permanently here
WORKER_EMBED=

# What one training run costs, in cents. Read by both the button and the worker
# that prices the finished job, so the number quoted and the number billed come
# from one place.
FAL_PRICE_LORA_TRAIN_CENTS=

# How often abandoned work goes back on the queue, in milliseconds.
#
# A job whose renderer died stays `claimed` until something expires its lease —
# and for a long time nothing did, so a restarted API left a training run
# counting upward forever. Every API process runs this: it is one idempotent
# UPDATE whose own WHERE clause stops two of them doing it twice.
#
# Clamped to 5s–1h, default 60s: the shortest lease anyone takes is 30s, so this
# finds a dead renderer within about a lease of it going quiet.
STUDIO_REAP_MS=

#   off   do not reap in this process
STUDIO_REAPER=
