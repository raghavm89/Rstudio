{
  "name": "rstudio-backend",
  "version": "1.0.0",
  "description": "Backend API for managing users",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node src/db/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test \"tests/**/*.test.js\" \"studio/comfyui/*.test.js\"",
    "studio:preflight": "node studio/preflight.js",
    "studio:worker": "node worker/index.js",
    "studio:test": "node --test \"tests/studio/*.test.js\"",
    "studio:persona": "node studio/load-persona.js",
    "studio:seed-set": "node studio/seed-set.js",
    "studio:cull": "node studio/cull.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.2.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.41",
    "morgan": "^1.10.1",
    "ms": "^2.1.3",
    "node-ssh": "^13.2.1",
    "pg": "^8.12.0",
    "razorpay": "^2.9.6",
    "twilio": "^5.13.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
